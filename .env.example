# Neo4j (event-graph driver)
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# LLM — event-graph pipeline (app.pipeline.event_graph.config.EventGraphSettings)
OPENAI_API_KEY=
# Vuoto = endpoint OpenAI ufficiale. Valorizza per server OpenAI-compatible (LM Studio, vLLM…)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Origini browser autorizzate (CORS), separate da virgola
CORS_ORIGINS=http://localhost:3000

# Event graph — ingest / estrazione
EVENT_GRAPH_FLASH_MODE=false
# Livello ancore (AncoraTemporale): acceso di default. false = niente LLM temporale,
# niente scritture AncoraTemporale, niente temporal_placement.
EVENT_GRAPH_TEMPORAL_ENABLED=true
EVENT_GRAPH_LLM_TIMEOUT=300
EVENT_GRAPH_LLM_CONCURRENCY=4
EVENT_GRAPH_LLM_MAX_TOKENS=6000
EVENT_GRAPH_TARGET_CHUNK_WORDS=350
EVENT_GRAPH_MAX_CHUNK_WORDS=500
EVENT_GRAPH_EXTRACTION_MAX_CALLS=3
EVENT_GRAPH_TEMPORAL_MAX_CANDIDATES=10

# Frontend (Compose build args + runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_EVENTS=false

# --- Codice Metagraph dormiente (kernel, judge, /documents legacy) ---
# Le variabili ENABLE_JUDGE, AUTO_MIGRATE, EMBEDDING_MODEL, ecc. non sono lette
# dal backend live (main.py monta solo /event-graph). Restano nei file legacy sotto app/.
