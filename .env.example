# Neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# OpenAI (required for real extraction / dreaming / query answers)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Cross-encoder multilingue per il rerank di POST /graph/query (layer Node)
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Backend
AUTO_MIGRATE=true
LLM_MAX_CONCURRENCY=5
# Origini browser autorizzate a chiamare l'API (CORS), separate da virgola
CORS_ORIGINS=http://localhost:3000
# derives (astrazione da pattern) temporaneamente disattivata: semantica da rivedere.
# true per riabilitarla (i gruppi consolidati tornano a produrre archi DERIVES).
ENABLE_DERIVES=false
# Fase 4 TBox classification (MEMBER_OF). false is a kill switch.
ENABLE_KERNEL_CLASSIFICATION=true
# Fase 5 PROMOTE of Node clusters. Off by default: no clustering criterion yet
# (wraps *all* of a catch-all's members into one node, never a real split).
ENABLE_PROMOTE=false
# Backbone match: reuse vs near-band catch-all (doc4 §3).
BACKBONE_REUSE_THRESHOLD=0.80
BACKBONE_NEAR_THRESHOLD=0.50
# Backbone MDL two-threshold baseline (doc4 §1). Coverage AND payload; both required.
# doc4's own defaults (5, 2) rarely fire PROMOTE on a realistic/small corpus.
BACKBONE_MDL_MIN_COVERAGE=3
BACKBONE_MDL_MIN_PAYLOAD=1
# Fase 7: S1 generalization hops up IS_A (stop before kernel catch-all).
CONNECTIVITY_MAX_GENERALIZATION_HOPS=1
# Fase 8: identity-as-facets instead of destructive merge_nodes. Default off.
ENABLE_FACET_IDENTITY=false
# Fase 9: three-way temporal transitions. Also on when ENABLE_FACET_IDENTITY is true.
ENABLE_TEMPORAL_TRANSITIONS=true
# Blocking cosine on summary embeddings (doc4 §2). Same kernel_category required.
IDENTITY_BLOCK_THRESHOLD=0.82
# Fase 10: post-batch judge at end of every dreaming batch. Default on (:JudgeRun).
ENABLE_JUDGE=true
# ϕ_collapse for equivalent_to between promoted sibling Concepts (doc4 §5).
BACKBONE_COLLAPSE_THRESHOLD=0.90
# Fase 20–22: relevance gate + :PendingHypothesis + context agent. Default off.
ENABLE_CONTEXT_LAYER=false
PENDING_HYPOTHESIS_LISTEN_WINDOW=5
# Fase 22: ReAct turn cap (do not retune).
CONTEXT_AGENT_MAX_TURNS=4

# Frontend (Compose build args + runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_EVENTS=false
