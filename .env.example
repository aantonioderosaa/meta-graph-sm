# Neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

OPENAI_API_KEY=
# Vuoto = endpoint OpenAI ufficiale. Valorizza per puntare a un server
# OpenAI-compatible locale (LM Studio, vLLM, llama.cpp...), es. http://localhost:1234/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Cross-encoder multilingue per il rerank di POST /graph/query (layer Node)
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Backend
AUTO_MIGRATE=true
LLM_MAX_CONCURRENCY=5
# Origini browser autorizzate a chiamare l'API (CORS), separate da virgola
CORS_ORIGINS=http://localhost:3000
# derives (astrazione da pattern) temporaneamente disattivata: semantica da rivedere.
# true per riabilitarla (i gruppi consolidati tornano a produrre archi DERIVES).
ENABLE_DERIVES=false
# Fase 4 TBox classification (MEMBER_OF). false is a kill switch.
ENABLE_KERNEL_CLASSIFICATION=true
# Fase 5 PROMOTE of Node clusters. Off by default: no clustering criterion yet
# (wraps *all* of a catch-all's members into one node, never a real split).
ENABLE_PROMOTE=false
# Backbone match: reuse vs near-band catch-all (doc4 §3).
BACKBONE_REUSE_THRESHOLD=0.80
BACKBONE_NEAR_THRESHOLD=0.50
# Backbone MDL two-threshold baseline (doc4 §1). Coverage AND payload; both required.
# doc4's own defaults (5, 2) rarely fire PROMOTE on a realistic/small corpus.
BACKBONE_MDL_MIN_COVERAGE=3
BACKBONE_MDL_MIN_PAYLOAD=1
# Fase 7: S1 generalization hops up IS_A (stop before kernel catch-all).
CONNECTIVITY_MAX_GENERALIZATION_HOPS=1
# Fase 8 (identity-as-facets) was removed with identity_resolution.py — merge_nodes
# is the only dedup path now, no flag to set here.
# Fase 9: three-way temporal transitions.
ENABLE_TEMPORAL_TRANSITIONS=true
# Blocking cosine on summary embeddings (doc4 §2). Same kernel_category required.
IDENTITY_BLOCK_THRESHOLD=0.82
# Fase 10: post-batch judge at end of every dreaming batch. Default on (:JudgeRun).
ENABLE_JUDGE=true
# Compito 5 (missed contradictions) was removed with _task_missed_contradictions —
# the T1 succession/error markers never fired on non-contemporary prose, and every
# same-head/same-kernel_parent pair got flagged CONTRADICTS and never resolved.
# CONTRADICTS is still written by entity_relation_resolution.py / write_contradicts;
# the judge's temporal task still reclassifies it into SUPERSEDES/UPDATED_BY.
# ϕ_collapse for equivalent_to between promoted sibling Concepts (doc4 §5).
BACKBONE_COLLAPSE_THRESHOLD=0.90
# Fasi 20–22 (relevance gate / :PendingHypothesis / quantifiers / retraction /
# context agent) were removed — relevance_gate.py, pending_hypothesis.py,
# quantifier_events.py, retraction.py, context_agent.py are gone, no flag here.
# Event triage (assert/retract with provenance) in the judge: three fixed phases
# (search, inspect, decide) per :Evento. Default off until a production rollout.
ENABLE_EVENT_TRIAGE=false
# Waiting-events hard cap on checks_without_progress before event_triage marks an
# event "incomplete" instead of leaving it "waiting" forever. Reused by event_triage
# only — the pending-hypothesis feature it originated with is gone.
PENDING_HYPOTHESIS_LISTEN_WINDOW=5

# Frontend (Compose build args + runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_EVENTS=false
