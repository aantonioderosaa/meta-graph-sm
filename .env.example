# Neo4j
NEO4J_PASSWORD=changeme
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# OpenAI (required for real extraction / dreaming / query answers)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Cross-encoder multilingue per il rerank di POST /graph/query (layer Node)
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Backend
AUTO_MIGRATE=true
LLM_MAX_CONCURRENCY=5
# Origini browser autorizzate a chiamare l'API (CORS), separate da virgola
CORS_ORIGINS=http://localhost:3000
# derives (astrazione da pattern) temporaneamente disattivata: semantica da rivedere.
# true per riabilitarla (i gruppi consolidati tornano a produrre archi DERIVES).
ENABLE_DERIVES=false

# Frontend (Compose build args + runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_EVENTS=false
